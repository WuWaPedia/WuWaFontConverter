---
import '../styles/app.css'

interface Props {
	title?: string
}
const { title = '鸣潮文字转换器' } = Astro.props
---

<!doctype html>
<html lang='zh-Hans'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width,initial-scale=1' />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
